NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://securityops:securityops@localhost:5432/securityops
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=8
DEV_SEED_ENABLED=false
# Set these only in a local, untracked .env when running npm run seed:dev.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=
DEV_SEED_TENANT_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM=notifications@securityops.local
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
BACKUP_DIRECTORY=./backups
DMS_STORAGE_PROVIDER=minio
DMS_MAX_BYTES=52428800
DMS_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,text/plain
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=securityops-dms
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_CHUNK_BYTES=1048576
DMS_BLOB_BACKUP_PROVIDER=not-configured
DMS_BLOB_BACKUP_STATUS=unknown
TIMESCAN_API_TOKEN=
LOG_LEVEL=info
