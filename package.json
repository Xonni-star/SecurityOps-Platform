{
  "name": "securityops-platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w backend && npm run build -w frontend",
    "migrate": "npm run migrate -w backend",
    "loadtest": "npm run loadtest -w backend",
    "loadtest:fixture": "npm run loadtest:fixture -w backend",
    "test": "npm test -w backend && npm test -w frontend",
    "test:coverage": "npm test -w backend -- --coverage && npm test -w frontend -- --coverage",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "e2e": "npm run e2e:deps && playwright test",
    "e2e:deps": "./scripts/e2e-dependencies.sh",
    "e2e:fixture": "npm run e2e:fixture -w backend",
    "test:e2e": "playwright test",
    "test:production-compose": "./scripts/production-compose-test.sh",
    "format": "prettier --write .",
    "cap:sync": "npm run build -w frontend && npx cap sync",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  }
}
